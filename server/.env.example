# Prod ortamı için environment variable listesi. Gerçek değerler bu dosyaya değil, sunucunun ortam değişkenlerine
# yazılır (prod .env okumaz). Ayrıntı: docs/Backend_Architecture.md §15

SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://db-host:5432/starterapp
DB_USERNAME=starterapp
DB_PASSWORD=change-me
# Uygulamanın tabloları bu şemada durur (küçük harf). Paylaşılan veritabanlarında diğer şemalara dokunulmaz.
DB_SCHEMA=starterapp

# RS256 anahtarları (PEM dosyaları; birden fazla replica varsa hepsi aynı anahtarı kullanır)
JWT_KEY_ID=key-2026-10
JWT_PRIVATE_KEY_PATH=/etc/guvenlipaylasim/keys/private.pem
JWT_PUBLIC_KEY_PATH=/etc/guvenlipaylasim/keys/public.pem
# Anahtar değişimi sırasında bir önceki public key (isteğe bağlı)
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY_PATH=

# Frontend farklı bir origin'deyse virgülle ayrılmış liste; aynı origin'deyse boş bırakılır
CORS_ALLOWED_ORIGINS=https://app.firma.com
COOKIE_SECURE=true

# Reverse proxy arkasındaysa native (gerçek istemci IP'si X-Forwarded-For'dan okunur)
FORWARD_HEADERS_STRATEGY=none
